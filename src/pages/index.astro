---
import Base from '../layouts/Base.astro';
import Opening from '../components/home/Opening.astro';
import Featured from '../components/home/Featured.astro';
import Archive from '../components/Archive.astro';
import Human from '../components/home/Human.astro';
import Closing from '../components/Closing.astro';
import { heroPhoto, heroPhotoMobile } from '../data/projects';
import { photoUrl, photoSrcset } from '../lib/img';
---

<Base
  current="home"
  preload={[
    { href: photoUrl(heroPhoto, 1600), srcset: photoSrcset(heroPhoto), sizes: '100vw', media: '(min-width: 900px)' },
    { href: photoUrl(heroPhotoMobile, 800), srcset: photoSrcset(heroPhotoMobile, 1600), sizes: '100vw', media: '(max-width: 899px)' },
  ]}
>
  <Opening />
  <Featured />
  <Archive />
  <Human />
  <Closing />
</Base>

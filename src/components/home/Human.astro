---
/**
 * Cena 05 — O lado humano
 * Única fotografia real disponível no manual: as duas irmãs fundadoras.
 * Textos adaptados do manual (Sobre a empresa, Significado do nome, Pilares,
 * Experiência do cliente, O que vendemos).
 */
import { Picture } from 'astro:assets';
import Photo from '../Photo.astro';
import irmas from '../../assets/photos/duetto-irmas.png';
import { studioPhotos } from '../../data/projects';
import { site } from '../../data/site';

const experience = [
  { step: 'Antes', quote: 'Será que vou ficar bem nas fotos?' },
  { step: 'Durante', quote: 'Estou confortável.' },
  { step: 'Resultado', quote: 'Isso parece comigo.' },
  { step: 'Depois', quote: 'Eu faria novamente.' },
];

const pillars = [
  { name: 'Qualidade', text: 'Técnica e estética em cada trabalho.' },
  { name: 'Acolhimento', text: 'Uma experiência confortável e segura.' },
  { name: 'Compromisso', text: 'Do atendimento à entrega.' },
  { name: 'Autenticidade', text: 'Cada pessoa tem uma história e um objetivo.' },
];

const services = [
  { name: 'Imagem profissional', area: 'Marca', text: 'Posicionamento, autoridade e comunicação para profissionais, empreendedores e empresas.', filter: 'marca' },
  { name: 'Experiência e registro', area: 'Pessoal', text: 'Ensaios pessoais, gestantes, famílias, aniversários e momentos especiais.', filter: 'pessoal' },
  { name: 'História em movimento', area: 'Audiovisual', text: 'Produção de vídeo com a mesma direção e sensibilidade da fotografia.', filter: 'audiovisual' },
  { name: 'Estrutura para criar', area: 'Locação', text: 'Estúdio para criadores e profissionais produzirem foto e vídeo.', filter: null },
];

const founders = site.founders ? `${site.founders[0]} e ${site.founders[1]}` : null;
---

<section class="hum" id="estudio" data-tone="light" data-scene="O lado humano" aria-labelledby="estudio-title">
  <!-- As pessoas -->
  <div class="hum__people wrap">
    <figure class="hum__portrait" data-mask>
      <Picture
        src={irmas}
        alt={founders ? `${founders}, fundadoras da Duetto, abraçadas no estúdio` : 'As duas irmãs fundadoras da Duetto, abraçadas no estúdio, uma delas segurando um celular'}
        widths={[480, 720, 864]}
        sizes="(min-width: 900px) 42vw, 100vw"
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        loading="lazy"
        class="hum__portrait-img"
        data-mask-img
      />
      <figcaption class="label label--soft">
        {founders ?? 'As fundadoras'} · Duetto Estúdio Fotográfico
      </figcaption>
    </figure>

    <div class="hum__copy">
      <p class="label label--accent" data-reveal>05 — O lado humano</p>
      <h2 class="h1" id="estudio-title" data-reveal style="--delay:.06s">
        Duetto significa <strong>união.</strong>
      </h2>
      <p class="lede" data-reveal style="--delay:.12s">
        A Duetto nasceu da união de duas irmãs, duas perspectivas e uma mesma paixão pela imagem.
      </p>
      <p class="body-copy" data-reveal style="--delay:.18s">
        Em {site.city}, o estúdio une fotografia, audiovisual e direção criativa para atender pessoas, profissionais e
        marcas — sempre buscando um resultado que vá além de uma imagem bonita. Diferentes olhares e habilidades,
        trabalhando juntas em uma mesma visão.
      </p>
    </div>
  </div>

  <!-- A experiência -->
  <div class="hum__exp wrap" data-exp>
    <div class="hum__exp-head">
      <p class="label label--accent">Como é estar com a gente</p>
      <h3 class="h2">Uma experiência <em>próxima, acolhedora e profissional.</em></h3>
    </div>
    <div class="hum__steps-wrap">
    <span class="hum__track" aria-hidden="true"><span class="hum__track-fill" data-exp-fill></span></span>
    <ol class="hum__steps">
      {experience.map((e, i) => (
        <li class="hum__step" data-exp-step style={`--i:${i}`}>
          <span class="hum__dot" aria-hidden="true"></span>
          <span class="label label--accent">{e.step}</span>
          <q class="h3">{e.quote}</q>
        </li>
      ))}
    </ol>
    </div>
  </div>

  <!-- Pilares + serviços -->
  <div class="hum__grid wrap">
    <div class="hum__pillars">
      <p class="label label--accent">No que acreditamos</p>
      <dl>
        {pillars.map((p) => (
          <div class="hum__pillar" data-reveal>
            <dt class="h3">{p.name}</dt>
            <dd class="body-copy">{p.text}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="hum__services">
      <p class="label label--accent">O que fazemos</p>
      <ul>
        {services.map((s) => (
          <li class="hum__service" data-reveal>
            <span class="label label--soft">{s.area}</span>
            <h4 class="h3">{s.name}</h4>
            <p class="body-copy">{s.text}</p>
            {s.filter ? (
              <a class="link" href={`/trabalhos/?tipo=${s.filter}`}>Ver trabalhos <span class="arrow" aria-hidden="true">→</span></a>
            ) : (
              <a class="link" href="#contato">Consultar disponibilidade <span class="arrow" aria-hidden="true">→</span></a>
            )}
          </li>
        ))}
      </ul>
    </div>
  </div>

  <!-- O espaço -->
  <div class="hum__space wrap">
    <div class="hum__space-copy">
      <p class="label label--accent">O estúdio</p>
      <h3 class="h2">Estrutura <em>para criar.</em></h3>
      <p class="body-copy">
        Um espaço preparado para ensaios, produções de marca e gravações — também disponível para locação por
        criadores e profissionais.
      </p>
    </div>
    <div class="hum__space-a" data-depth="-0.08">
      <Photo photo={studioPhotos.softbox} sizes="(min-width: 900px) 26vw, 60vw" maxWidth={1200} />
    </div>
    <div class="hum__space-b" data-depth="0.06">
      <Photo photo={studioPhotos.concreto} sizes="(min-width: 900px) 38vw, 80vw" maxWidth={1600} />
    </div>
  </div>
</section>

<style>
  .hum { padding-block: clamp(80px, 12vh, 150px) clamp(64px, 9vh, 110px); }
  .hum em { font-weight: 400; }

  /* pessoas */
  .hum__people {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(12px, 2vw, 32px);
    align-items: end;
  }
  .hum__portrait { grid-column: 1 / span 6; display: grid; gap: 14px; }
  .hum__portrait :global(picture) { display: block; overflow: hidden; aspect-ratio: 1; background: #c9c6cb; }
  .hum__portrait :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .hum__copy { grid-column: 8 / span 5; display: grid; gap: 22px; justify-items: start; padding-bottom: 24px; }
  .hum__copy .h1 { max-width: 9ch; }

  /* experiência */
  .hum__exp { margin-top: clamp(80px, 12vh, 150px); }
  .hum__exp-head { display: grid; gap: 18px; max-width: 46rem; margin-bottom: clamp(40px, 6vh, 72px); }
  .hum__steps-wrap { position: relative; }
  .hum__steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(16px, 2.4vw, 40px);
    padding-top: 36px;
  }
  .hum__track {
    position: absolute;
    top: 4px;
    left: 0;
    right: 0;
    height: 1px;
    background-image: linear-gradient(to right, var(--cafe-48) 50%, transparent 0);
    background-size: 8px 1px;
  }
  .hum__track-fill {
    position: absolute;
    inset: 0;
    background: var(--champagne-deep);
    transform-origin: left;
    transform: scaleX(var(--p, 1));
  }
  .hum__step { position: relative; display: grid; gap: 12px; align-content: start; }
  .hum__dot {
    position: absolute;
    top: -37px;
    left: 0;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--champagne-deep);
  }
  :global(html.scroll-animations) .hum__step { opacity: 0.32; transition: opacity 0.6s var(--ease-out); }
  :global(html.scroll-animations) .hum__step.is-on { opacity: 1; }
  .hum__step q { quotes: '“' '”'; display: block; max-width: 12ch; }

  /* pilares e serviços */
  .hum__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(12px, 2vw, 32px);
    margin-top: clamp(80px, 12vh, 150px);
  }
  .hum__pillars { grid-column: 1 / span 4; display: grid; gap: 26px; align-content: start; }
  .hum__pillars dl { display: grid; gap: 22px; }
  .hum__pillar { display: grid; gap: 6px; padding-top: 18px; border-top: 1px solid var(--line); }
  .hum__services { grid-column: 6 / span 7; display: grid; gap: 26px; align-content: start; }
  .hum__services ul { display: grid; grid-template-columns: 1fr 1fr; gap: 40px clamp(20px, 3vw, 56px); }
  .hum__service { display: grid; gap: 10px; justify-items: start; padding-top: 18px; border-top: 1px solid var(--line); }

  /* espaço */
  .hum__space {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(12px, 2vw, 32px);
    margin-top: clamp(80px, 12vh, 150px);
    align-items: end;
  }
  .hum__space-copy { grid-column: 1 / span 4; display: grid; gap: 18px; align-self: center; }
  .hum__space-a { grid-column: 5 / span 3; }
  .hum__space-b { grid-column: 8 / span 5; }

  @media (max-width: 899px) {
    .hum__people, .hum__grid, .hum__space { grid-template-columns: repeat(6, minmax(0, 1fr)); row-gap: 32px; }
    .hum__portrait { grid-column: 1 / -1; }
    .hum__copy { grid-column: 1 / -1; padding-bottom: 0; }
    .hum__steps { grid-template-columns: 1fr; padding-top: 0; padding-left: 30px; gap: 34px; }
    .hum__track { top: 0; bottom: 0; left: 4px; right: auto; width: 1px; height: auto; background-image: linear-gradient(to bottom, var(--cafe-48) 50%, transparent 0); background-size: 1px 8px; }
    .hum__track-fill { transform-origin: top; transform: scaleY(var(--p, 1)); }
    .hum__dot { top: 6px; left: -30px; }
    .hum__pillars, .hum__services { grid-column: 1 / -1; }
    .hum__services { margin-top: 40px; }
    .hum__services ul { grid-template-columns: 1fr; gap: 28px; }
    .hum__space-copy { grid-column: 1 / -1; padding-top: 0; }
    .hum__space-a { grid-column: 1 / span 3; }
    .hum__space-b { grid-column: 4 / span 3; }
  }
</style>

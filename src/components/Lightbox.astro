---
/**
 * Galeria ampliada. <dialog> nativo: foco preso, Esc fecha, fundo inerte.
 * Setas do teclado, botões visíveis e gesto de deslizar no celular.
 */
import type { Photo } from '../data/projects';
import { photoUrl, photoSrcset } from '../lib/img';

interface Props { photos: Photo[]; title: string }
const { photos, title } = Astro.props;
const data = photos.map((p) => ({
  src: photoUrl(p, 1600, 80),
  srcset: photoSrcset(p),
  alt: p.alt,
  ratio: p.ratio,
  tone: p.tone ?? '#000',
  provisional: p.src.startsWith('photo-'),
}));
---

<dialog class="lb" aria-label={`Galeria — ${title}`} data-lightbox>
  <div class="lb__stage" data-lb-stage>
    <figure class="lb__figure">
      <img class="lb__img" data-lb-img alt="" sizes="100vw" />
      <figcaption class="lb__cap">
        <span class="lb__count label" data-lb-count aria-live="polite"></span>
        <span class="lb__alt" data-lb-alt></span>
        <span class="lb__prov label" data-lb-prov>Imagem provisória</span>
      </figcaption>
    </figure>
  </div>
  <button class="lb__btn lb__close" type="button" data-lb-close aria-label="Fechar galeria">
    <span class="label">Fechar</span> <span aria-hidden="true" class="lb__x">×</span>
  </button>
  <button class="lb__btn lb__prev" type="button" data-lb-prev aria-label="Imagem anterior"><span aria-hidden="true">←</span></button>
  <button class="lb__btn lb__next" type="button" data-lb-next aria-label="Próxima imagem"><span aria-hidden="true">→</span></button>
</dialog>

<script type="application/json" data-lb-data set:html={JSON.stringify(data)} />

<style>
  .lb {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: #000;
    color: var(--off);
    overflow: hidden;
  }
  .lb::backdrop { background: #000; }
  .lb[open] { animation: lb-in 0.45s var(--ease-out); }
  @keyframes lb-in { from { opacity: 0; } }

  .lb__stage {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 72px clamp(16px, 7vw, 120px) 96px;
    touch-action: pan-y;
  }
  .lb__figure { display: grid; gap: 16px; justify-items: center; max-width: 100%; max-height: 100%; }
  .lb__img {
    max-width: 100%;
    max-height: calc(100dvh - 190px);
    width: auto;
    height: auto;
    object-fit: contain;
    transition: opacity 0.35s var(--ease-out), transform 0.5s var(--ease-out);
  }
  .lb__img.is-changing { opacity: 0; transform: scale(0.985); }
  .lb__cap { display: flex; flex-wrap: wrap; justify-content: center; align-items: baseline; gap: 6px 18px; text-align: center; font-size: var(--t-small); color: var(--off-72); max-width: 60ch; }
  .lb__count { color: var(--champagne); font-variant-numeric: tabular-nums; }
  .lb__prov { color: var(--champagne); }
  .lb__prov[hidden] { display: none; }

  .lb__btn {
    position: absolute;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-width: 48px;
    min-height: 48px;
    color: var(--off);
    transition: color 0.3s;
  }
  .lb__btn:hover { color: var(--champagne); }
  .lb__close { top: 12px; right: clamp(8px, 2vw, 28px); padding-inline: 10px; }
  .lb__x { font-size: 1.8rem; line-height: 1; font-weight: 200; }
  .lb__prev, .lb__next { top: 50%; transform: translateY(-50%); font-size: 1.4rem; width: 56px; height: 56px; border: 1px solid var(--off-16); border-radius: 50%; }
  .lb__prev { left: clamp(8px, 2vw, 32px); }
  .lb__next { right: clamp(8px, 2vw, 32px); }
  .lb__prev:hover, .lb__next:hover { border-color: var(--champagne); }

  @media (max-width: 899px) {
    .lb__stage { padding: 64px 12px 120px; }
    .lb__prev, .lb__next { top: auto; bottom: 22px; transform: none; }
    .lb__prev { left: 16px; }
    .lb__next { right: 16px; }
    .lb__cap { padding-inline: 64px; }
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  if (dialog) {
    type Item = { src: string; srcset?: string; alt: string; ratio: number; tone: string; provisional: boolean };
    const items: Item[] = JSON.parse(document.querySelector('[data-lb-data]')!.textContent || '[]');
    const img = dialog.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const count = dialog.querySelector<HTMLElement>('[data-lb-count]')!;
    const alt = dialog.querySelector<HTMLElement>('[data-lb-alt]')!;
    const prov = dialog.querySelector<HTMLElement>('[data-lb-prov]')!;
    let index = 0;
    let opener: HTMLElement | null = null;

    const preload = (i: number) => {
      const it = items[(i + items.length) % items.length];
      const im = new Image();
      im.sizes = '100vw';
      if (it.srcset) im.srcset = it.srcset;
      im.src = it.src;
    };

    const render = (i: number, animate = true) => {
      index = (i + items.length) % items.length;
      const it = items[index];
      const apply = () => {
        if (it.srcset) img.srcset = it.srcset; else img.removeAttribute('srcset');
        img.src = it.src;
        img.alt = it.alt;
        img.style.aspectRatio = String(it.ratio);
        dialog.style.setProperty('--tone', it.tone);
        count.textContent = `${String(index + 1).padStart(2, '0')} / ${String(items.length).padStart(2, '0')}`;
        alt.textContent = it.alt;
        prov.hidden = !it.provisional;
        const show = () => img.classList.remove('is-changing');
        if (img.complete) requestAnimationFrame(show); else img.onload = img.onerror = show;
      };
      if (animate && dialog.open) {
        img.classList.add('is-changing');
        setTimeout(apply, 180);
      } else apply();
      preload(index + 1);
      preload(index - 1);
    };

    const open = (i: number, from: HTMLElement) => {
      opener = from;
      render(i, false);
      dialog.showModal();
      document.documentElement.style.overflow = 'hidden';
    };

    document.addEventListener('click', (e) => {
      const trigger = (e.target as HTMLElement).closest<HTMLElement>('[data-zoom]');
      if (trigger) open(Number(trigger.dataset.zoom), trigger);
    });

    dialog.querySelector('[data-lb-close]')!.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-lb-prev]')!.addEventListener('click', () => render(index - 1));
    dialog.querySelector('[data-lb-next]')!.addEventListener('click', () => render(index + 1));
    // clique fora da imagem fecha
    dialog.querySelector('[data-lb-stage]')!.addEventListener('click', (e) => {
      if (e.target === e.currentTarget) dialog.close();
    });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); render(index + 1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); render(index - 1); }
      if (e.key === 'Home') { e.preventDefault(); render(0); }
      if (e.key === 'End') { e.preventDefault(); render(items.length - 1); }
    });
    dialog.addEventListener('close', () => {
      document.documentElement.style.overflow = '';
      opener?.focus({ preventScroll: true });
    });

    // deslizar
    let x0: number | null = null;
    dialog.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    dialog.addEventListener('touchend', (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 50) render(index + (dx < 0 ? 1 : -1));
      x0 = null;
    });
  }
</script>

---
/**
 * Indica a cena atual e gira o diafragma com o progresso de leitura.
 */
import Iris from './Iris.astro';
---

<div class="scene" data-scene-indicator aria-hidden="true">
  <span class="scene__iris" data-scene-iris><Iris /></span>
  <span class="scene__num label" data-scene-num>01</span>
  <span class="scene__rule"></span>
  <span class="scene__name label" data-scene-name></span>
</div>

<style>
  /* vertical, na margem esquerda — fora da área de composição */
  .scene {
    position: fixed;
    left: calc(var(--gutter) * 0.5 - 8px);
    bottom: 40px;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    z-index: 90;
    display: none;
    align-items: center;
    gap: 12px;
    color: var(--off);
    mix-blend-mode: difference;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.6s;
  }
  .scene.is-visible { opacity: 1; }
  .scene__iris { width: 16px; height: 16px; display: block; }
  .scene__iris :global(svg) { width: 100%; height: 100%; }
  .scene__rule { width: 1px; height: 28px; background: currentColor; opacity: 0.6; }
  .scene__num { font-variant-numeric: tabular-nums; }
  .scene__name { transition: opacity 0.4s; }
  .scene__iris { transform-origin: 50% 50%; }
  @media (min-width: 1100px) and (min-height: 560px) {
    .scene { display: flex; }
  }
</style>

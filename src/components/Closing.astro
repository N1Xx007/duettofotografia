---
/**
 * Cena 07 — Encerramento + rodapé integrado.
 * A fotografia final se abre como um diafragma — o mesmo gesto do símbolo da marca.
 */
import Photo from './Photo.astro';
import Logo from './Logo.astro';
import { closingPhoto } from '../data/projects';
import { site, whatsappUrl, primaryContact } from '../data/site';

interface Props { compact?: boolean }
const { compact = false } = Astro.props;

const contact = primaryContact();
const wa = whatsappUrl();
const year = new Date().getFullYear();
const ext = (href: string) => (href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {});
---

<section class:list={['end', compact && 'end--compact']} id="contato" data-tone="black" data-scene="Contato" aria-labelledby="contato-title">
  {!compact && (
    <div class="end__stage wrap">
      <h2 class="display end__title" id="contato-title">
        <span class="end__l1" data-depth="0.1">Toda imagem</span>
        <span class="end__l2" data-depth="-0.08">começa com <em>uma conversa.</em></span>
      </h2>
      <div class="end__img" data-aperture-close>
        <Photo photo={closingPhoto} fit="cover" sizes="(min-width: 900px) 30vw, 70vw" maxWidth={1200} />
      </div>
    </div>
  )}

  <div class="end__cta wrap">
    {compact && <h2 class="h1 end__title-compact" id="contato-title">Toda imagem começa com <em>uma conversa.</em></h2>}
    <p class="lede">Conte o que você imagina. A gente ajuda a transformar em fotografia.</p>
    <a class="btn" href={contact.href} {...ext(contact.href)}>
      Fale com o estúdio <span class="arrow" aria-hidden="true">→</span>
    </a>
    <p class="label label--soft end__via">{contact.label}</p>
  </div>

  <footer class="foot wrap">
    <span class="rule foot__rule" aria-hidden="true"></span>
    <div class="foot__grid">
      <a class="foot__logo" href="/" aria-label="Duetto Estúdio Fotográfico — início">
        <Logo variant="original" />
      </a>

      <div class="foot__col">
        <p class="label label--accent">Contato</p>
        <ul>
          <li><a class="link" href={site.contact.instagram.url} {...ext(site.contact.instagram.url)}>Instagram {site.contact.instagram.handle}</a></li>
          {wa && <li><a class="link" href={wa} {...ext(wa)}>WhatsApp</a></li>}
          {site.contact.email && <li><a class="link" href={`mailto:${site.contact.email}`}>{site.contact.email}</a></li>}
        </ul>
      </div>

      <div class="foot__col">
        <p class="label label--accent">Estúdio</p>
        <address>
          {site.contact.address ? <span>{site.contact.address}</span> : null}
          <span>{site.city} · {site.state}</span>
        </address>
      </div>

      <nav class="foot__col" aria-label="Rodapé">
        <p class="label label--accent">Navegação</p>
        <ul>
          <li><a class="link" href="/#trabalhos">Trabalhos</a></li>
          <li><a class="link" href="/trabalhos/">Acervo</a></li>
          <li><a class="link" href="/#estudio">Estúdio</a></li>
        </ul>
      </nav>
    </div>

    <div class="foot__base label label--soft">
      <p>{site.tagline}</p>
      <p>© {year} {site.name}</p>
      <p>Imagens provisórias: Unsplash · substituir pelo acervo Duetto</p>
      <a href="#conteudo" class="foot__top">Voltar ao início ↑</a>
    </div>
  </footer>
</section>

<style>
  .end { position: relative; padding-top: clamp(72px, 11vh, 140px); overflow: hidden; }
  .end--compact { padding-top: clamp(32px, 5vh, 64px); }

  .end__stage {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(12px, 2vw, 32px);
    align-items: center;
    min-height: min(84vh, 820px);
  }
  .end__title {
    grid-column: 1 / -1;
    grid-row: 1;
    position: relative;
    z-index: 2;
    display: grid;
    gap: 0.1em;
    font-size: clamp(3rem, 1.2rem + 7vw, 9.6rem);
    pointer-events: none;
  }
  .end__l1 { justify-self: start; }
  .end__l2 { justify-self: end; text-align: right; margin-top: clamp(200px, 40vh, 420px); }
  .end__title em { color: var(--champagne); }
  .end__img { grid-column: 5 / span 4; grid-row: 1; width: min(100%, calc(76vh * 0.68)); aspect-ratio: 0.68; justify-self: center; z-index: 1; }

  .end__cta {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 26px;
    padding-block: clamp(56px, 9vh, 110px);
  }
  /* a etiqueta sobe para não colidir com o título que cruza a foto */
  .end__img :global(.ph__flag) { top: 10px; bottom: auto; }
  .end__title-compact { max-width: 16ch; }
  .end__title-compact em { color: var(--champagne); }
  .end__via { margin-top: -8px; }

  .foot { padding-bottom: max(32px, env(safe-area-inset-bottom)); }
  .foot__rule { margin-bottom: clamp(48px, 8vh, 96px); }
  .foot__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) repeat(3, minmax(0, 2fr));
    gap: 40px clamp(20px, 3vw, 56px);
    align-items: start;
  }
  .foot__logo { width: clamp(200px, 22vw, 340px); display: block; }
  .foot__col { display: grid; gap: 14px; align-content: start; font-size: var(--t-small); }
  .foot__col ul { display: grid; gap: 4px; }
  .foot__col address { font-style: normal; display: grid; gap: 4px; color: var(--fg-soft); }
  .foot__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 28px;
    margin-top: clamp(56px, 10vh, 120px);
    padding-top: 22px;
    border-top: 1px solid var(--line);
  }
  .foot__top:hover { color: var(--off); }

  @media (max-width: 899px) {
    .end__stage { min-height: 0; grid-template-columns: repeat(6, minmax(0, 1fr)); }
    .end__title { font-size: clamp(2.6rem, 12vw, 4.4rem); }
    .end__l2 { margin-top: 78vw; }
    .end__img { grid-column: 2 / span 4; height: auto; max-height: none; width: 100%; align-self: center; }
    .foot__grid { grid-template-columns: 1fr 1fr; }
    .foot__logo { grid-column: 1 / -1; width: 220px; }
    .foot__base { flex-direction: column; }
  }
</style>

---
/**
 * Cena 04 — Exploração do acervo
 * Índice editorial filtrável. Desktop: a lista conduz uma moldura de prévia fixa
 * (sem imagem seguindo o cursor). Celular: cada linha já traz sua miniatura.
 */
import Photo from './Photo.astro';
import { photoUrl, photoSrcset, photoTone } from '../lib/img';
import { projects, activeCategories, categoryById } from '../data/projects';

interface Props {
  /** "home": cena da página inicial; "page": página /trabalhos. */
  variant?: 'home' | 'page';
}
const { variant = 'home' } = Astro.props;
const HeadingTag = variant === 'page' ? 'h1' : 'h2';
const counts = Object.fromEntries(activeCategories.map((c) => [c.id, projects.filter((p) => p.category === c.id).length]));
const previewData = Object.fromEntries(projects.map((p) => [p.slug, {
  src: photoUrl(p.cover, 1200), srcset: photoSrcset(p.cover, 1600),
  alt: p.cover.alt, ratio: p.cover.ratio, tone: photoTone(p.cover),
  focus: p.cover.focus ?? '50% 50%', lede: p.lede,
  provisional: p.cover.src.startsWith('photo-'),
}]));
---

<section class:list={['arc', `arc--${variant}`]} id="acervo" data-tone="light" data-scene="Acervo" aria-labelledby="acervo-title" data-archive>
  <div class="wrap">
    <header class="arc__head">
      <p class="label label--accent">{variant === 'home' ? '04 — Acervo' : 'Acervo Duetto'}</p>
      <HeadingTag class="h1 arc__title" id="acervo-title">
        Explore por <em>tipo de história.</em>
      </HeadingTag>
      <p class="body-copy arc__note">
        Retratos, ensaios, gestantes, famílias, celebrações e audiovisual. Os trabalhos exibidos são ilustrativos,
        com imagens provisórias, até a publicação do acervo do estúdio.
      </p>

      <div class="arc__filters" role="group" aria-label="Filtrar trabalhos por categoria">
        <button type="button" class="arc__filter" aria-pressed="true" data-filter="todos">
          Todos <span class="arc__count">{projects.length}</span>
        </button>
        {activeCategories.map((c) => (
          <button type="button" class="arc__filter" aria-pressed="false" data-filter={c.id}>
            {c.label} <span class="arc__count">{counts[c.id]}</span>
          </button>
        ))}
      </div>
    </header>

    <div class="arc__body">
      <ol class="arc__list" data-arc-list>
        {projects.map((p, i) => (
          <li class="arc__item" data-cat={p.category} data-slug={p.slug} data-reveal style={`--delay:${(i % 4) * 0.06}s`}>
            <a class="arc__link" href={`/trabalhos/${p.slug}/`}>
              <span class="arc__thumb" aria-hidden="true">
                <Photo photo={p.cover} sizes="30vw" maxWidth={800} flag={false} />
              </span>
              <span class="arc__num num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="arc__name h2">{p.title}</span>
              <span class="arc__cat label">{categoryById(p.category).label}</span>
              <span class="arc__go" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ol>

      <div class="arc__preview" aria-hidden="true" data-arc-preview>
        <div class="arc__preview-frame">
          <div class="arc__pv" data-pv={projects[0].slug}>
            <Photo photo={projects[0].cover} sizes="(min-width: 900px) 40vw, 1px" maxWidth={1600} />
          </div>
        </div>
        <p class="arc__pv-lede body-copy" data-pv-lede>{projects[0].lede}</p>
      </div>
    </div>

    <p class="sr-only" aria-live="polite" data-arc-status></p>
  </div>
</section>

<script is:inline type="application/json" data-arc-previews set:html={JSON.stringify(previewData)} />

<style>
  .arc { padding-block: clamp(80px, 12vh, 150px); }
  .arc--page { padding-top: calc(var(--header-h) + clamp(60px, 12vh, 140px)); }
  .arc__head { display: grid; gap: 22px; justify-items: start; margin-bottom: clamp(36px, 6vh, 72px); }
  .arc__title { max-width: 13ch; }
  .arc__title em { font-weight: 400; }
  .arc__note { max-width: 40em; }

  .arc__filters { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 18px; }
  .arc__filter {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 42px;
    padding: 0 16px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
    color: var(--fg-soft);
    transition: background-color 0.35s, color 0.35s, border-color 0.35s;
  }
  .arc__filter:hover { border-color: var(--fg); color: var(--fg); }
  .arc__filter[aria-pressed='true'] { background: var(--cafe); border-color: var(--cafe); color: var(--off); }
  .arc__count { font-size: 0.6875rem; opacity: 0.7; font-variant-numeric: tabular-nums; }

  .arc__body {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(24px, 5vw, 96px);
    align-items: start;
  }

  .arc__list { border-top: 1px solid var(--line); }
  .arc__item { border-bottom: 1px solid var(--line); }
  .arc__item.is-hidden { display: none; }

  .arc__link {
    display: grid;
    grid-template-columns: 3.2rem minmax(0, 1fr) auto 1.4rem;
    align-items: baseline;
    gap: 16px;
    padding: clamp(18px, 2.4vh, 28px) 0;
    transition: color 0.3s;
  }
  .arc__thumb { display: none; }
  .arc__num { font-size: 1rem; color: var(--accent); }
  .arc__name { font-size: clamp(1.7rem, 1.1rem + 1.9vw, 3.2rem); transition: transform 0.6s var(--ease-out); }
  .arc__cat { color: var(--fg-soft); text-align: right; }
  .arc__go { opacity: 0; transform: translateX(-8px); transition: opacity 0.4s, transform 0.5s var(--ease-out); color: var(--accent); }

  @media (hover: hover) and (min-width: 900px) {
    .arc__list:hover .arc__link { color: var(--cafe-48); }
    .arc__list .arc__link:hover,
    .arc__list .arc__link:focus-visible { color: var(--fg); }
    .arc__link:hover .arc__name,
    .arc__link:focus-visible .arc__name { transform: translateX(10px); }
    .arc__link:hover .arc__go,
    .arc__link:focus-visible .arc__go { opacity: 1; transform: none; }
  }

  .arc__preview { position: sticky; top: calc(var(--header-h) + 4vh); }
  /* cada capa aparece inteira, na própria proporção, dentro de uma área fixa */
  .arc__preview-frame { --pv-h: min(64vh, 620px); position: relative; height: var(--pv-h); }
  .arc__pv {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
  }
  .arc__pv :global(.ph) { width: min(100%, calc(var(--pv-h) * var(--ratio))); }
  .arc__pv-lede { margin-top: 18px; min-height: 3.2em; }

  @media (max-width: 899px) {
    .arc__body { grid-template-columns: 1fr; }
    .arc__preview { display: none; }
    .arc__filters { flex-wrap: nowrap; overflow-x: auto; width: calc(100% + 2 * var(--gutter)); margin-inline: calc(-1 * var(--gutter)); padding-inline: var(--gutter); scrollbar-width: none; }
    .arc__filters::-webkit-scrollbar { display: none; }
    .arc__filter { flex: none; }
    .arc__link {
      grid-template-columns: 30vw minmax(0, 1fr);
      grid-template-rows: auto auto 1fr;
      align-items: start;
      column-gap: 18px;
      row-gap: 6px;
      padding: 16px 0;
    }
    .arc__thumb { display: block; grid-row: 1 / span 3; }
    .arc__num { grid-column: 2; font-size: 0.875rem; }
    .arc__name { grid-column: 2; font-size: 1.75rem; }
    .arc__cat { grid-column: 2; text-align: left; }
    .arc__go { display: none; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-archive]');
  if (root) {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const items = [...root.querySelectorAll<HTMLLIElement>('.arc__item')];
    const status = root.querySelector<HTMLElement>('[data-arc-status]')!;
    const preview = root.querySelector<HTMLElement>('[data-pv]')!;
    const previewQuery = window.matchMedia('(min-width: 900px)');
    const ledeEl = root.querySelector<HTMLElement>('[data-pv-lede]');
    type Preview = { src: string; srcset?: string; alt: string; ratio: number; tone: string; focus: string; lede: string; provisional: boolean };
    const previews: Record<string, Preview> = JSON.parse(document.querySelector('[data-arc-previews]')?.textContent || '{}');

    const show = (slug?: string) => {
      if (!slug || !previewQuery.matches || preview.dataset.pv === slug) return;
      const data = previews[slug];
      if (!data) return;
      const photo = preview.querySelector<HTMLElement>('.ph')!;
      const img = preview.querySelector<HTMLImageElement>('img')!;
      photo.classList.remove('is-error');
      photo.style.setProperty('--ratio', String(data.ratio));
      photo.style.setProperty('--tone', data.tone);
      photo.style.setProperty('--focus', data.focus);
      if (data.srcset) img.srcset = data.srcset; else img.removeAttribute('srcset');
      img.src = data.src;
      img.alt = data.alt;
      img.width = 1000;
      img.height = Math.round(1000 / data.ratio);
      const flag = preview.querySelector<HTMLElement>('.ph__flag');
      if (flag) flag.hidden = !data.provisional;
      preview.dataset.pv = slug;
      if (ledeEl) ledeEl.textContent = data.lede;
    };

    const apply = (filter: string, announce = true) => {
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === filter)));
      let n = 0;
      items.forEach((li) => {
        const match = filter === 'todos' || li.dataset.cat === filter;
        li.classList.toggle('is-hidden', !match);
        if (match) {
          n++;
        }
      });
      const first = items.find((li) => !li.classList.contains('is-hidden'));
      show(first?.dataset.slug);
      const btn = buttons.find((b) => b.dataset.filter === filter);
      const label = btn?.firstChild?.textContent?.trim() ?? '';
      if (announce) status.textContent = `${n} ${n === 1 ? 'trabalho' : 'trabalhos'}${filter === 'todos' ? '' : ` em ${label}`}.`;

      const url = new URL(location.href);
      if (filter === 'todos') url.searchParams.delete('tipo');
      else url.searchParams.set('tipo', filter);
      history.replaceState(history.state, '', url);
    };

    buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.filter!)));

    // prévia acompanha o ponteiro e o foco do teclado
    items.forEach((li) => {
      const link = li.querySelector('a')!;
      link.addEventListener('pointerenter', () => show(li.dataset.slug));
      link.addEventListener('focus', () => show(li.dataset.slug));
    });

    const initial = new URL(location.href).searchParams.get('tipo');
    if (initial && buttons.some((b) => b.dataset.filter === initial)) apply(initial, false);
    previewQuery.addEventListener('change', () => show(items.find((li) => !li.classList.contains('is-hidden'))?.dataset.slug));
  }
</script>

---
import Logo from './Logo.astro';
import { site, primaryContact } from '../data/site';

interface Props { current?: string }
const { current } = Astro.props;

const nav = [
  { href: '/#trabalhos', label: 'Trabalhos', key: 'home' },
  { href: '/trabalhos/', label: 'Acervo', key: 'trabalhos' },
  { href: '/#estudio', label: 'Estúdio', key: '' },
  { href: '/#contato', label: 'Contato', key: '' },
];
const contact = primaryContact();
---

<header class="hdr" data-header>
  <div class="hdr__bar">
    {current !== 'home' && (
      <a class="hdr__logo" href="/" aria-label="Duetto Estúdio Fotográfico — página inicial">
        <Logo variant="original" title="Duetto Estúdio Fotográfico" />
      </a>
    )}

    <nav class="hdr__nav" aria-label="Principal">
      <ul>
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={item.key && item.key === current ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <a class="hdr__cta" href={contact.href} target={contact.href.startsWith('http') ? '_blank' : undefined} rel="noopener">
      Fale com o estúdio
    </a>

    <button class="hdr__toggle" type="button" aria-expanded="false" aria-controls="menu" data-menu-toggle>
      <span class="hdr__toggle-label" data-menu-label>Menu</span>
      <span class="hdr__toggle-lines" aria-hidden="true"><i></i><i></i></span>
    </button>
  </div>

  <div class="menu" id="menu" hidden data-menu>
    <nav aria-label="Menu">
      <ol class="menu__list">
        {nav.map((item, i) => (
          <li>
            <a href={item.href}>
              <span class="num">{String(i + 1).padStart(2, '0')}</span>
              {item.label}
            </a>
          </li>
        ))}
      </ol>
    </nav>
    <div class="menu__foot">
      <p class="label label--accent">{site.tagline}</p>
      <a class="link" href={site.contact.instagram.url} target="_blank" rel="noopener">Instagram {site.contact.instagram.handle}</a>
      <p class="label label--soft">{site.city} · {site.state}</p>
    </div>
  </div>
</header>

<style>
  .hdr {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    color: var(--off);
    pointer-events: none;
  }
  .hdr__bar {
    position: relative;
    display: flex;
    align-items: center;
    gap: 32px;
    height: var(--header-h);
    padding-inline: var(--gutter);
    pointer-events: auto;
    transition: transform 0.6s var(--ease-out), background-color 0.5s;
  }
  .hdr__bar::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--cafe);
    opacity: 0;
    transition: opacity 0.5s;
  }
  .hdr.is-solid .hdr__bar::before { opacity: 1; }
  .hdr.is-hidden .hdr__bar { transform: translateY(-100%); }
  .hdr.is-open .hdr__bar { transform: none; }
  .hdr.is-open .hdr__bar::before { opacity: 0; }

  .hdr__logo { width: clamp(118px, 10vw, 150px); flex: none; }

  .hdr__nav { margin-left: auto; }
  .hdr__nav ul { display: flex; gap: clamp(20px, 2.6vw, 44px); }
  .hdr__nav a,
  .hdr__cta {
    position: relative;
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 400;
    padding-block: 8px;
  }
  .hdr__nav a::after {
    content: '';
    position: absolute;
    left: 0; right: 0; bottom: 2px;
    height: 1px;
    background: var(--champagne);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s var(--ease-out);
  }
  .hdr__nav a:hover::after,
  .hdr__nav a[aria-current='page']::after { transform: scaleX(1); }

  .hdr__cta {
    padding: 11px 18px 10px;
    border: 1px solid rgb(214 180 122 / 0.7);
    color: var(--champagne);
    transition: background-color 0.3s, color 0.3s;
  }
  .hdr__cta:hover { background: var(--champagne); color: var(--cafe); }

  .hdr__toggle {
    display: none;
    align-items: center;
    gap: 12px;
    margin-left: auto;
    min-height: 44px;
    padding-inline: 4px;
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .hdr__toggle-lines { position: relative; width: 26px; height: 10px; }
  .hdr__toggle-lines i {
    position: absolute;
    left: 0; right: 0;
    height: 1px;
    background: currentColor;
    transition: transform 0.5s var(--ease-out), top 0.5s var(--ease-out);
  }
  .hdr__toggle-lines i:first-child { top: 0; }
  .hdr__toggle-lines i:last-child { top: 9px; }
  .hdr.is-open .hdr__toggle-lines i:first-child { top: 5px; transform: rotate(18deg); }
  .hdr.is-open .hdr__toggle-lines i:last-child { top: 5px; transform: rotate(-18deg); }

  /* ------------------------------------------------ menu sobreposto */
  .menu {
    position: fixed;
    inset: 0;
    z-index: -1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: calc(var(--header-h) + 6vh) var(--gutter) max(32px, env(safe-area-inset-bottom));
    background: var(--cafe);
    pointer-events: auto;
    overflow-y: auto;
  }
  .menu[hidden] { display: none; }
  .menu__list li { border-top: 1px solid var(--off-16); }
  .menu__list li:last-child { border-bottom: 1px solid var(--off-16); }
  .menu__list a {
    display: flex;
    align-items: baseline;
    gap: 18px;
    padding: 14px 0;
    font-family: var(--font-title);
    font-size: clamp(2.4rem, 10vw, 4.4rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  .menu__list .num { font-size: 0.9rem; color: var(--champagne); min-width: 2ch; }
  .menu__foot { display: grid; gap: 10px; margin-top: 40px; }
  :global(html.motion) .menu:not([hidden]) .menu__list li {
    animation: menu-in 0.8s var(--ease-out) both;
  }
  :global(html.motion) .menu__list li:nth-child(2) { animation-delay: 0.05s; }
  :global(html.motion) .menu__list li:nth-child(3) { animation-delay: 0.1s; }
  :global(html.motion) .menu__list li:nth-child(4) { animation-delay: 0.15s; }
  @keyframes menu-in {
    from { opacity: 0; transform: translateY(18px); }
  }

  @media (max-width: 899px) {
    .hdr__nav,
    .hdr__cta { display: none; }
    .hdr__toggle { display: inline-flex; }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const toggle = header.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
  const label = header.querySelector<HTMLElement>('[data-menu-label]')!;
  const menu = header.querySelector<HTMLElement>('[data-menu]')!;
  const main = document.getElementById('conteudo');

  /* Esconde ao descer, mostra ao subir; fundo sólido após a primeira tela */
  let lastY = window.scrollY;
  let ticking = false;
  const update = () => {
    const y = window.scrollY;
    const open = header.classList.contains('is-open');
    header.classList.toggle('is-solid', y > window.innerHeight * 0.6);
    if (!open) header.classList.toggle('is-hidden', y > lastY && y > 160);
    lastY = y;
    ticking = false;
  };
  window.addEventListener('scroll', () => {
    if (!ticking) { requestAnimationFrame(update); ticking = true; }
  }, { passive: true });
  update();
  header.addEventListener('focusin', () => header.classList.remove('is-hidden'));

  /* Menu móvel */
  const setOpen = (open: boolean) => {
    header.classList.toggle('is-open', open);
    toggle.setAttribute('aria-expanded', String(open));
    label.textContent = open ? 'Fechar' : 'Menu';
    menu.hidden = !open;
    document.documentElement.style.overflow = open ? 'hidden' : '';
    if (main) main.inert = open;
    if (open) menu.querySelector<HTMLAnchorElement>('a')?.focus();
  };
  toggle.addEventListener('click', () => setOpen(!header.classList.contains('is-open')));
  menu.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && header.classList.contains('is-open')) {
      setOpen(false);
      toggle.focus();
    }
  });
  window.matchMedia('(min-width: 900px)').addEventListener('change', (e) => e.matches && setOpen(false));
</script>
